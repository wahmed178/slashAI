<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient glow circle container in safe zone -->
    <path
        android:pathData="M54,20 A34,34 0 1,0 54,88 A34,34 0 1,0 54,20 Z"
        android:fillColor="#18202A" />

    <!-- Sleek Slash Accent Strip -->
    <path
        android:pathData="M37,74 L61,28 L67,30 L43,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="74"
                android:endX="67"
                android:endY="28"
                android:type="linear">
                <item android:offset="0.0" android:color="#2DD4BF" />
                <item android:offset="1.0" android:color="#818CF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Electric Lightning Bolt Glyph -->
    <path
        android:pathData="M57,24 L38,54 L51,54 L45,84 L69,50 L56,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="84"
                android:endX="69"
                android:endY="24"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.4" android:color="#2DD4BF" />
                <item android:offset="1.0" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
